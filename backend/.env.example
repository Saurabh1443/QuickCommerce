# ======================================================================================
# QuickCommerce backend environment. Copy to backend/.env and fill in real values.
# Never commit the real .env file.
# ======================================================================================

# --- Django core ---------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO
SQLITE_NAME=db.sqlite3

# --- CORS / frontend -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- JWT ------------------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Google Maps ----------------------------------------------------------------------
# Server-side key (used for optional geocoding helpers). Restrict it by IP in GCP.
# Enable: Maps JavaScript API, Places API, Geocoding API.
GOOGLE_MAPS_API_KEY=

# --- Razorpay -------------------------------------------------------------------------
# From dashboard.razorpay.com -> Settings -> API Keys (use TEST mode keys for dev).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
DEFAULT_ONLINE_GATEWAY=RAZORPAY
# Keep True for local dev: when Razorpay keys are empty the online flow runs in an
# explicit local sandbox mode instead of failing. Set to False before production.
PAYMENTS_ALLOW_SANDBOX=True

# --- Email notifications --------------------------------------------------------------
# Dev default prints emails to the console. For real email use:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=QuickCommerce <no-reply@quickcommerce.local>
ADMIN_NOTIFICATION_EMAIL=admin@quickcommerce.local
NOTIFICATION_ENABLED_CHANNELS=EMAIL

# --- Events (Redis Streams) -----------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
EVENT_BUS_BACKEND=redis
EVENT_STREAM_NAME=quickcommerce.events
EVENT_CONSUMER_GROUP=quickcommerce-workers
EVENT_BUS_FALLBACK_SYNC=True

# --- Business defaults ----------------------------------------------------------------
SHOP_DISCOVERY_RADIUS_KM=10
DEFAULT_DELIVERY_FEE=25
MAX_UPLOAD_SIZE_MB=5
