# Copy to frontend/.env and fill in real values. Never commit the real .env file.

VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Google Maps JavaScript API key (enable Maps JavaScript API + Places API in GCP).
# Restrict this key by HTTP referrer since it is exposed to the browser.
VITE_GOOGLE_MAPS_API_KEY=

# Razorpay publishable Key ID (safe to expose to the browser). Use TEST mode for dev.
VITE_RAZORPAY_KEY_ID=
